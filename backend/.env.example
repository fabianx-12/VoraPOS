# ─────────────────────────────────────────────────────────────────────────────
# VoraPOS Backend — Environment Variable Template
# Copy this file to .env and fill in the values for your environment.
# NEVER commit the actual .env file to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Terminal Identity ─────────────────────────────────────────────────────────
# Human-readable name for this POS terminal (used in logs and sync payloads)
TERMINAL_ID=POS-TERMINAL-01

# ── SQLite Edge Database ──────────────────────────────────────────────────────
# Absolute or relative path to the SQLite database file.
# Never store inside node_modules or the repository root.
DATABASE_PATH=./vorapos.db

# ── Fastify Cloud Sync API ────────────────────────────────────────────────────
# Port the local Fastify server listens on (for cloud-hub deployment mode)
SERVER_PORT=3000

# ── Cloud PostgreSQL Hub ──────────────────────────────────────────────────────
# Full HTTPS URL of the central sync ingestion API
CLOUD_SYNC_URL=https://sync.vorapos.example.com/api/v1

# Shared secret / bearer token for authenticating outbox batches
CLOUD_SYNC_API_KEY=your-secret-api-key-here

# ── Background Sync Worker ────────────────────────────────────────────────────
# How often (ms) the outbox worker polls for PENDING events
SYNC_INTERVAL_MS=30000

# Maximum number of outbox events to send per sync batch
SYNC_BATCH_SIZE=50

# ── Hardware Interface ────────────────────────────────────────────────────────
# Set to 'mock' for development/testing (no physical printer required).
# Set to 'usb', 'serial', or 'network' for production.
PRINTER_INTERFACE=mock

# Serial port or USB path for the thermal printer (ignored when mock)
# Windows example: COM3    Linux example: /dev/ttyUSB0
PRINTER_PORT=COM3

# ── Application Mode ─────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info
